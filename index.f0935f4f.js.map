"use strict";
var container = document.querySelector(".container");
var table = document.querySelector(".field tbody");
var rowAmount = table.children.length;
var columnAmount = table.children[0].children.length;
container.addEventListener("click", function(e) {
    if (e.target.closest(".append-row")) {
        if (rowAmount >= 10) return;
        var newTr = document.createElement("tr");
        for(var i = 0; i < columnAmount; i++){
            var newTd = document.createElement("td");
            newTr.append(newTd);
        }
        table.append(newTr);
        rowAmount = table.children.length;
        changeButtonState();
    }
    if (e.target.closest(".remove-row")) {
        table.children[rowAmount - 1].remove();
        rowAmount = table.children.length;
        changeButtonState();
    }
    if (e.target.closest(".append-column")) {
        if (columnAmount >= 10) return;
        for(var i1 = 0; i1 < rowAmount; i1++){
            var newTd1 = document.createElement("td");
            table.children[i1].append(newTd1);
        }
        columnAmount = table.children[0].children.length;
        changeButtonState();
    }
    if (e.target.closest(".remove-column")) {
        for(var i2 = 0; i2 < rowAmount; i2++)table.children[i2].children[columnAmount - 1].remove();
        columnAmount = table.children[0].children.length;
        changeButtonState();
    }
});
function changeButtonState() {
    var maxLimit = 10;
    var minLimit = 2;
    document.querySelector(".append-row").disabled = rowAmount === maxLimit;
    document.querySelector(".remove-row").disabled = rowAmount === minLimit;
    document.querySelector(".append-column").disabled = columnAmount === maxLimit;
    document.querySelector(".remove-column").disabled = columnAmount === minLimit;
}

